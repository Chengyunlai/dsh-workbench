{
  "name": "@yunlai/dsh-workbench",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build-client.mjs",
    "test": "npm run build && node --test --test-timeout=300000 test/*.test.mjs",
    "test:languages": "node --test test/languages.e2e.mjs",
    "setup:languages": "node scripts/configure-languages.mjs",
    "setup:debuggers": "node scripts/configure-debuggers.mjs",
    "test:debug": "node --test test/debug.e2e.mjs",
    "check": "node scripts/repository-checks.mjs",
    "check:generated": "git ls-files --error-unmatch client.js client.terminal.js && git diff --exit-code -- client.js client.terminal.js",
    "test:package": "node scripts/package-smoke.mjs",
    "verify": "npm test && npm run check && npm run check:generated",
    "setup:ci-tools": "node scripts/setup-ci-tools.mjs"
  },
  "description": "Development workbench for DeepSeek Harness: files, code navigation, document previews, Git diffs and history, and breakpoint debugging with expression evaluation.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client.terminal.js": "./client.terminal.js"
  },
  "files": [
    "index.js",
    "client.js",
    "client.terminal.js",
    "navigation.js",
    "workspace-search.js",
    "image-preview.js",
    "language-config.js",
    "language-servers.js",
    "scripts/configure-languages.mjs",
    "typescript-worker.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "debug-dap.js",
    "debug-service.js",
    "debug-targets.js",
    "scripts/configure-debuggers.mjs",
    "DEBUGGING.md",
    "DEBUGGING.en.md",
    "USAGE.md",
    "USAGE.en.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "SECURITY.md",
    "SECURITY.en.md",
    "AUTOMATION.md",
    "AUTOMATION.en.md",
    "UPGRADING.md",
    "UPGRADING.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-terminal-controller"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "pyright": "1.1.414",
    "typescript": "6.0.3",
    "vscode-jsonrpc": "10.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror-lang-makefile": "0.1.1",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chengyunlai/dsh-workbench.git"
  },
  "homepage": "https://github.com/Chengyunlai/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/Chengyunlai/dsh-workbench/issues"
  },
  "keywords": [
    "deepseek-harness",
    "workbench",
    "git",
    "debugger",
    "lsp",
    "code-navigation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0",
    "dsh": ">=0.2.1-rc.5"
  }
}
